        "messages": {
          "values": [
            {
              "content": "=You are an expert B2B cold email copywriter.\n\nCreate a concise, personalized cold email using the lead information, company research, sales research brief, and lead qualification.\n\nThe goal is to start a conversation about AI automation services.\n\nRequirements:\n- Personalize the email using the contact's name, job title, and company.\n- Reference a relevant insight from the research when available.\n- Mention a plausible AI automation opportunity only when supported by the research.\n- Keep the email concise and natural.\n- Do not make unsupported claims.\n- Do not mention that AI was used to write the email.\n- Do not use generic phrases such as \"I hope you're doing well.\"\n- End with a simple 15-minute call-to-action.\n- Return ONLY the email in this format:\n\nSubject: [short personalized subject]\n\nBody:\n[Email body]\n\nLead Information:\nCompany: {{ $('Lead Input').item.json.company }}\nWebsite: {{ $('Lead Input').item.json.website }}\nContact: {{ $('Lead Input').item.json.contact_name }}\nJob Title: {{ $('Lead Input').item.json.job_title }}\n\nCompany Research:\n{{ $('Company Research').item.json.data }}\n\nLead Qualification:\n{{ $('Message a model1').item.json.content.parts[0].text }}\n\nSales Research Brief:\n{{ $('Message a model').item.json.content.parts[0].text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
